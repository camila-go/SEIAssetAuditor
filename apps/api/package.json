{
  "name": "@capella/api",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./services": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build",
    "start": "node dist/index.js",
    "build:ui": "node ../../scripts/build-ui.mjs",
    "install:ui": "node ../../scripts/install-ui.mjs",
    "build:static": "BUILD_STATIC=1 node ../../scripts/build-ui.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@capella/db": "*",
    "@capella/queue": "*",
    "@capella/scraper": "*",
    "@capella/types": "*",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.13",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "zod": "^3.23.8",
    "@capella/embedding": "*"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.0.0"
  }
}
