# ─── Required ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/capella_dam
REDIS_URL=redis://localhost:6379
AEM_PUBLIC_HOST=https://www.capella.edu

API_PORT=3001
NODE_ENV=development
UI_ORIGIN=http://localhost:5173

# ─── Phase 2: AEM read-only audit account ──────────────────────────────────
# Account: capella-dam-audit-svc. See docs/dam-permissions.md for the IT request.
# Leave disabled and every Phase 2 feature returns a structured 501.
AEM_API_ENABLED=false
AEM_AUTHOR_HOST=https://author.capella.edu
AEM_SERVICE_ACCOUNT_USER=
AEM_SERVICE_ACCOUNT_PASSWORD=
AEM_PAGE_PATH=/content/capella/en
# Query Builder: GET ${AEM_AUTHOR_HOST}/bin/querybuilder.json
# The servlet's default limit is 10 hits — the client refuses any query without
# an explicit p.limit, so this cannot silently truncate.

# ─── Video intake: AEM write account (separate credentials) ────────────────
# Account: capella-dam-intake-svc. Write scope is ONLY the two paths below —
# these exact values are what IT grants (docs/dam-permissions.md) and what the
# code enforces in assertWritablePath. Change them and the account must be
# re-scoped to match, or every upload fails closed.
#
# Both live in the shared SEI DAM as of 2026-09-17. They were under
# /content/dam/capella/, which the audit side found is the legacy tree.
AEM_INTAKE_ENABLED=false
AEM_INTAKE_WRITE_USER=
AEM_INTAKE_WRITE_PASSWORD=
AEM_INTAKE_STAGING_PATH=/content/dam/sei/capella/intake/pending
AEM_INTAKE_LIVE_ROOT=/content/dam/sei/capella
MAX_VIDEO_BYTES=2147483648

# sequential: legal → marketing → live DAM
# parallel:   both notified at submission, both must approve
# TBD pending Legal + Marketing alignment — see docs/open-questions.md
APPROVAL_CHAIN_MODE=sequential

# ─── Approver authentication ───────────────────────────────────────────────
# Placeholder until the Capella SSO decision. Without it, every internal route
# fails closed with a 401 — these routes move assets into the live DAM.
INTERNAL_AUTH_TOKEN=

# ─── Legal documents ───────────────────────────────────────────────────────
# Signed PDFs are stored here, never pushed to AEM.
# MUST be outside the web root and not publicly served.
LEGAL_DOC_STORAGE_PATH=/var/capella-dam/legal-docs
MAX_LEGAL_DOC_BYTES=10485760
# Hosted separately and owned by Legal — the copy still needs Legal sign-off.
LEGAL_TERMS_URL=https://www.capella.edu/legal/video-submission-terms

# ─── Email notifications ───────────────────────────────────────────────────
# With no SMTP host, notifications are logged instead of sent — fine for dev.
EMAIL_FROM=noreply@capella.edu
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
LEGAL_APPROVER_EMAIL=
MARKETING_APPROVER_EMAIL=

# ─── Transcription ─────────────────────────────────────────────────────────
# Whisper: $0.006/min — a 10 min video is about $0.06, 100 videos/month about $6.
# Audio is extracted to /tmp/{jobId}.mp3 and deleted in a finally block.
# ffmpeg must exist on the WORKER host; the worker warns and disables
# transcription rather than crashing if it is missing.
TRANSCRIPTION_ENABLED=true
OPENAI_API_KEY=
FFMPEG_PATH=/usr/bin/ffmpeg

# Chapter detection from the transcript text. Optional — without a key the
# transcript and captions are still produced, just without chapter markers.
ANTHROPIC_API_KEY=
CHAPTER_DETECTION_MODEL=claude-haiku-4-5

# ─── Scraper ───────────────────────────────────────────────────────────────
# Playwright headless Chromium — capella.edu is JS-rendered and a static fetch
# returns navigation only.
SCRAPER_CONCURRENCY=5            # concurrent Playwright pages; keep at 5, it is far heavier than fetch
SCRAPER_PAGE_TIMEOUT_MS=30000    # per page, then mark failed and continue
SCRAPER_BATCH_SIZE=5             # URLs claimed from the DB per batch
SCRAPER_USER_AGENT=SEI-Site-Auditor/1.0 (internal)
SCRAPER_POLITENESS_DELAY_MS=200

# ─── Semantic search ───────────────────────────────────────────────────────
# Local sentence model (all-MiniLM-L6-v2) — no API key, no per-query cost.
# The model downloads once on first use (~25MB) and runs in the worker.
SEMANTIC_SEARCH_ENABLED=true

# ─── Worker ────────────────────────────────────────────────────────────────
WORKER_AUDIT_CONCURRENCY=1         # audit JOBS at once, not pages
WORKER_TRANSCRIPTION_CONCURRENCY=2

# ─── Phase 3: Social APIs ──────────────────────────────────────────────────
SOCIAL_ENABLED=false
META_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_API_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
