{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:ui",
  "outputDirectory": "apps/ui/dist",
  "installCommand": "npm ci --workspace=@capella/ui --include-workspace-root",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
