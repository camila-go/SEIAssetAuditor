node_modules/
dist/
# apps/ui's tsconfig emits declarations here. `dist/` does not match it, so 46
# generated files were committed in the initial import and re-churned on every
# build.
dist-types/
# Generated from the committed snapshot by scripts/build-static-data.mjs.
apps/ui/public/data/
# Mirror written by scripts/build-ui.mjs when a host starts the build inside a
# workspace instead of at the repo root.
apps/*/apps/
build/
*.tsbuildinfo

# Environment — never commit
.env
.env.local
.env.test
.env.*.local

# Prisma
packages/db/prisma/migrations/dev.db*

# Legal document storage (signed PDFs) — never in the repo
legal-docs/

# Test + tooling output
coverage/
playwright-report/
test-results/
.eslintcache

# OS
.DS_Store
.model-cache/
