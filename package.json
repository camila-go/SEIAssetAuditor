{
  "name": "sei-site-auditor",
  "version": "1.5.0",
  "private": true,
  "description": "SEI Site Auditor \u2014 AEM asset auditing, reverse image search, testimonial management, and video intake for capella.edu",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "// build:packages": "The shared packages must be compiled before apps/* can resolve them \u2014 `tsc --build` walks the project references in dependency order.",
    "build:packages": "tsc --build packages/types packages/db packages/queue packages/scraper",
    "predev": "npm run db:generate && npm run build:packages",
    "dev": "concurrently -n api,ui,worker -c blue,green,magenta \"npm run dev:api\" \"npm run dev:ui\" \"npm run dev:worker\"",
    "dev:api": "npm run dev --workspace=@capella/api",
    "dev:ui": "npm run dev --workspace=@capella/ui",
    "dev:worker": "npm run dev --workspace=@capella/worker",
    "prebuild": "npm run db:generate",
    "build": "tsc --build && npm run build --workspace=@capella/ui",
    "//test": "Every package is ESM, so ts-jest needs Node's ESM VM modules. Without the flag it silently downlevels to CommonJS and any file using import.meta fails to compile — three suites disappeared exactly that way.",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:e2e": "playwright test --config=apps/ui/playwright.config.ts",
    "lint": "eslint . --ext .ts,.tsx && tsc --build --dry",
    "typecheck": "tsc --build",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/prisma/seed.ts",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma",
    "crawl": "tsx apps/worker/src/scripts/manualCrawl.ts",
    "embed:prewarm": "npm run build --workspace=@capella/embedding && node packages/embedding/prewarm.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.15.0",
    "ts-jest": "^29.1.4",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "sharp@0.33.5": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "msgpackr-extract@3.0.4": true
  }
}
